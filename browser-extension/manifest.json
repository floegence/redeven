{
  "manifest_version": 3,
  "name": "Redeven Flower",
  "version": "1.0.4",
  "description": "Let Flower work in the browser tabs you authorize.",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "webNavigation",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Redeven Flower",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "minimum_chrome_version": "125"
}
