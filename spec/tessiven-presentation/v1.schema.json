{
  "type": "object",
  "required": [
    "format",
    "model",
    "capabilities",
    "compatibility"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "redeven.io/tessiven-presentation/v1"
    },
    "model": {
      "type": "object",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "maxItems": 20000
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          },
          "maxItems": 20000
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          },
          "maxItems": 20000
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/instance"
          },
          "maxItems": 20000
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "maxItems": 20000
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          },
          "maxItems": 20000
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 20000
        },
        "presentation": {
          "type": "object",
          "properties": {
            "direction": {
              "type": "string",
              "enum": [
                "RIGHT",
                "DOWN",
                "LEFT",
                "UP"
              ]
            },
            "layers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20000,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20000,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                }
              }
            },
            "initiallyExpanded": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "uniqueItems": true,
              "maxItems": 20000
            },
            "order": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "uniqueItems": true,
              "maxItems": 20000
            },
            "positions": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "type": "object",
                "properties": {
                  "objectRef": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                  },
                  "x": {
                    "type": "number",
                    "minimum": -1000000,
                    "maximum": 1000000
                  },
                  "y": {
                    "type": "number",
                    "minimum": -1000000,
                    "maximum": 1000000
                  }
                },
                "required": [
                  "objectRef",
                  "x",
                  "y"
                ],
                "additionalProperties": false
              }
            },
            "groupLayouts": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "flow"
                ],
                "properties": {
                  "flow": {
                    "type": "string",
                    "enum": [
                      "row",
                      "column"
                    ]
                  },
                  "maxPerLine": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "objects": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "type": "string",
                "maxLength": 200
              },
              "facts": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 4000
                    }
                  }
                }
              },
              "objectRefs": {
                "type": "array",
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        }
      },
      "required": [
        "metadata"
      ],
      "additionalProperties": false,
      "title": "Tessiven ServiceCanvas DSL v1.1.0"
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]{1,64}$"
      }
    },
    "compatibility": {
      "type": "object",
      "required": [
        "status",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "complete",
            "limited",
            "unavailable"
          ]
        },
        "limitations": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "type": "object",
            "required": [
              "code",
              "object_refs"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 100
              },
              "object_refs": {
                "type": "array",
                "maxItems": 20000,
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "feature": {
                "type": "string",
                "maxLength": 100
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "healthy",
            "degraded",
            "unavailable",
            "unknown"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "uniqueItems": true,
          "maxItems": 20000,
          "minItems": 1
        }
      },
      "required": [
        "state",
        "observedAt",
        "evidenceRefs"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "runtimeRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observation": {
          "$ref": "#/$defs/observation"
        }
      },
      "required": [
        "id",
        "name",
        "runtimeRef"
      ],
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "nodeRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "uniqueItems": true,
          "maxItems": 20000
        },
        "instanceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 20000
        }
      },
      "required": [
        "id",
        "name",
        "nodeRefs"
      ],
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "type": "string",
          "enum": [
            "gateway",
            "web",
            "api",
            "worker",
            "database",
            "cache",
            "search",
            "queue",
            "scheduler",
            "controller",
            "runtime",
            "network",
            "dns",
            "monitoring",
            "workload",
            "coordination",
            "security",
            "logging",
            "storage",
            "analytics",
            "ai",
            "cloud_controller",
            "node_agent",
            "container_runtime",
            "network_plugin",
            "service_mesh",
            "ingress",
            "operator",
            "registry",
            "metrics",
            "tracing",
            "alerting",
            "identity",
            "secrets",
            "certificate",
            "stream_processor",
            "metadata",
            "service"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "additionalProperties": false
    },
    "instance": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "nodeRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "serviceRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "replica",
            "peer",
            "standalone",
            "unknown"
          ]
        },
        "shard": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "observation": {
          "$ref": "#/$defs/observation"
        }
      },
      "required": [
        "id",
        "nodeRef",
        "serviceRef",
        "role"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "enum": [
            "managed_service",
            "container"
          ]
        },
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "engine": {
          "type": "string",
          "enum": [
            "docker",
            "podman"
          ]
        },
        "endpointId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "owner",
        "resourceId"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "owner": {
                "const": "container"
              }
            }
          },
          "then": {
            "required": [
              "engine",
              "endpointId"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "engine"
                  ]
                },
                {
                  "required": [
                    "endpointId"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "resource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "type": "string",
          "enum": [
            "domain",
            "cdn",
            "load_balancer",
            "database",
            "cache",
            "object_store",
            "nas",
            "filesystem",
            "queue",
            "external"
          ]
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "observation": {
          "$ref": "#/$defs/observation"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "calls",
            "forwards",
            "resolves",
            "reads",
            "writes",
            "accesses",
            "mounts",
            "replicates",
            "peers"
          ]
        },
        "protocol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "uniqueItems": true,
          "maxItems": 20000,
          "minItems": 1
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "kind",
        "evidenceRefs"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "source": {
          "type": "string",
          "enum": [
            "code",
            "configuration",
            "runtime",
            "inference"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "source",
        "locator",
        "summary"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "runtime"
              }
            }
          },
          "then": {
            "required": [
              "observedAt"
            ]
          }
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    }
  },
  "$id": "https://redeven.io/tessiven-presentation/v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
