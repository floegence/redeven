{
  "extends": "./tsconfig.typecheck.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@floegence/floe-webapp-core": [
        "node_modules/@floegence/floe-webapp-core"
      ],
      "@floegence/floe-webapp-core/*": [
        "node_modules/@floegence/floe-webapp-core/dist/*"
      ],
      "marked": [
        "node_modules/marked/lib/marked.d.ts"
      ],
      "thinking-orbs/engine": [
        "node_modules/thinking-orbs/dist/engine/index.d.ts"
      ],
      "solid-js": [
        "node_modules/solid-js"
      ],
      "solid-js/*": [
        "node_modules/solid-js/*"
      ],
      "vitest": [
        "node_modules/vitest"
      ],
      "lucide-solid": [
        "node_modules/lucide-solid"
      ],
      "qrcode-generator": [
        "./node_modules/qrcode-generator/dist/qrcode.d.ts"
      ]
    }
  },
  "include": [
    "tests/envCenterContract.test.ts",
    "src/envcenter/**/*.ts",
    "src/envcenter/**/*.tsx",
    "../internal/envcenter_web/src/**/*.ts",
    "../internal/envcenter_web/src/**/*.tsx"
  ]
}
