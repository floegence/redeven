# The certificate must cover the portal and every registered environment hostname.
# Terminate TLS in Center, or use a TCP passthrough edge. Forwarded headers do not authorize requests.
CENTER_ORIGIN=https://center.example.com:8443
CENTER_LISTEN=0.0.0.0:8443
CENTER_TLS_CERT=/etc/redeven-center/server.pem
CENTER_TLS_KEY=/etc/redeven-center/server-key.pem
