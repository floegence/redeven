[Unit]
Description=Redeven Web Environment Connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=redeven-connector
Group=redeven-center
RuntimeDirectory=redeven-connector
RuntimeDirectoryMode=0750
ExecStart=/opt/redeven-center/redeven-center connector --connector-socket /run/redeven-connector/connector.sock --center-user redeven-center
Restart=on-failure
RestartSec=1
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/var/lib/redeven-center -/etc/redeven-center
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
