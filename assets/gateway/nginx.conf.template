# TLS passthrough preserves Gateway device certificates and one public protocol.
# UPSTREAM is the unified Gateway TLS listener, never the private host socket.
# Requires Nginx's stream module. Render placeholders before starting Nginx.
worker_processes 1;
pid "@PID@";
error_log /dev/null;
events { worker_connections 1024; }
stream {
    log_format gateway_safe '$time_iso8601 status=$status bytes_sent=$bytes_sent bytes_received=$bytes_received duration=$session_time';
    access_log "@ACCESS_LOG@" gateway_safe;
    server {
        listen @LISTEN@;
        proxy_pass @UPSTREAM@;
        proxy_connect_timeout 10s;
        proxy_timeout 660s;
        proxy_socket_keepalive on;
    }
}
