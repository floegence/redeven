  "resources": [
    {
      "id": "r-ha-proxy",
      "name": "HA 访问入口负载均衡",
      "kind": "load_balancer",
      "description": "为 Active NameNode / ResourceManager 的 Web UI 与 REST 提供稳定入口，按 /isActive 探针转发。"
    },
    {
      "id": "r-kdc",
      "name": "Kerberos KDC（外部认证中心）",
      "kind": "external",
      "description": "安全模式下集群守护进程与客户端的统一身份认证来源。"
    },
    {
      "id": "r-metastore-db",
      "name": "Hive Metastore 元数据库（MySQL / PostgreSQL）",
      "kind": "database",
      "description": "存放 Hive 表结构、分区等元数据。"
    },
    {
      "id": "r-object-store",
      "name": "对象存储归档（S3 / OSS）",
      "kind": "object_store",
      "description": "HDFS 冷数据归档与分层存储目标，经 DistCp 写入。"
    },
    {
      "id": "r-monitoring",
      "name": "监控与告警平台（Prometheus / Grafana）",
      "kind": "external",
      "description": "采集 NameNode、DataNode、NodeManager、RegionServer 指标并告警。"
    }
  ],
