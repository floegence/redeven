{
  "apiVersion": "redeven.io/tessiven/v1",
  "kind": "ServiceCanvas",
  "metadata": {
    "title": "Hadoop 服务架构图（HDFS + YARN HA 参考架构）",
    "description": "概念性参考架构，不描述任何当前连接或已观测的 Runtime：分层、服务与依赖均依据 Apache Hadoop 3.3.5 官方文档（HDFS HA + QJM、ResourceManager HA、HDFS/YARN/MapReduce 架构）推导。nodes 的 runtimeRef 只是占位描述，不可连接、不授予任何权限；所有 relation 的证据来源为推断与标准配置项，未在真实集群上观测。"
  },
  "nodes": [
    {
      "id": "n-client",
      "name": "客户端节点（Hadoop Client）",
      "runtimeRef": "conceptual:hadoop-ref-arch/client-01"
    },
    {
      "id": "n-master-a",
      "name": "主控节点 A（NameNode Active / ResourceManager Active）",
      "runtimeRef": "conceptual:hadoop-ref-arch/master-01"
    },
    {
      "id": "n-master-b",
      "name": "主控节点 B（NameNode Standby / ResourceManager Standby）",
      "runtimeRef": "conceptual:hadoop-ref-arch/master-02"
    },
    {
      "id": "n-coord-1",
      "name": "协调节点 1（ZooKeeper / JournalNode）",
      "runtimeRef": "conceptual:hadoop-ref-arch/coord-01"
    },
    {
      "id": "n-coord-2",
      "name": "协调节点 2（ZooKeeper / JournalNode）",
      "runtimeRef": "conceptual:hadoop-ref-arch/coord-02"
    },
    {
      "id": "n-coord-3",
      "name": "协调节点 3（ZooKeeper / JournalNode）",
      "runtimeRef": "conceptual:hadoop-ref-arch/coord-03"
    },
    {
      "id": "n-worker-1",
      "name": "工作节点 1（DataNode / NodeManager）",
      "runtimeRef": "conceptual:hadoop-ref-arch/worker-01"
    },
    {
      "id": "n-worker-2",
      "name": "工作节点 2（DataNode / NodeManager）",
      "runtimeRef": "conceptual:hadoop-ref-arch/worker-02"
    },
    {
      "id": "n-worker-3",
      "name": "工作节点 3（DataNode / NodeManager）",
      "runtimeRef": "conceptual:hadoop-ref-arch/worker-03"
    },
    {
      "id": "n-eco",
      "name": "生态服务节点（Hive / HBase）",
      "runtimeRef": "conceptual:hadoop-ref-arch/eco-01"
    }
  ],
  "groups": [
    {
      "id": "g-access",
      "name": "客户端接入层",
      "nodeRefs": [
        "n-client"
      ]
    },
    {
      "id": "g-master",
      "name": "HDFS 元数据与 YARN 调度主控层",
      "nodeRefs": [
        "n-master-a",
        "n-master-b"
      ]
    },
    {
      "id": "g-coord",
      "name": "协调与仲裁层（ZooKeeper 集群 + JournalNode 集群）",
      "nodeRefs": [
        "n-coord-1",
        "n-coord-2",
        "n-coord-3"
      ]
    },
    {
      "id": "g-worker",
      "name": "数据与计算工作节点层",
      "nodeRefs": [
        "n-worker-1",
        "n-worker-2",
        "n-worker-3"
      ]
    },
    {
      "id": "g-eco",
      "name": "生态服务层",
      "nodeRefs": [
        "n-eco"
      ]
    }
  ],
  "services": [
    {
      "id": "svc-hdfs-namenode",
      "name": "HDFS NameNode",
      "kind": "service",
      "description": "HDFS 命名空间与块映射的唯一元数据服务，HA 下为一主一备。"
    },
    {
      "id": "svc-hdfs-journalnode",
      "name": "HDFS JournalNode",
      "kind": "service",
      "description": "共享 Edit Log（Quorum Journal Manager）仲裁存储，Active 写入、Standby 读取，至少 3 个节点。"
    },
    {
      "id": "svc-hdfs-datanode",
      "name": "HDFS DataNode",
      "kind": "worker",
      "description": "数据块存储与副本复制，向所有 NameNode 上报块位置与心跳。"
    },
    {
      "id": "svc-yarn-resourcemanager",
      "name": "YARN ResourceManager",
      "kind": "service",
      "description": "YARN 资源与作业调度主控，Active/Standby 通过内嵌 ZooKeeper 选举器选主。"
    },
    {
      "id": "svc-yarn-nodemanager",
      "name": "YARN NodeManager",
      "kind": "worker",
      "description": "单节点资源管理与容器执行代理，向 ResourceManager 汇报并领取容器。"
    },
    {
      "id": "svc-mapreduce-am",
      "name": "MapReduce ApplicationMaster",
      "kind": "worker",
      "description": "每个作业一个，向 ResourceManager 申请容器并调度 Map/Reduce 任务。"
    },
    {
      "id": "svc-mapreduce-jhs",
      "name": "MapReduce JobHistoryServer",
      "kind": "service",
      "description": "MapReduce 作业历史与日志归档查询服务。"
    },
    {
      "id": "svc-zookeeper",
      "name": "ZooKeeper 仲裁集群",
      "kind": "service",
      "description": "HDFS 自动故障转移与 YARN RM 选举的协调服务，通常 3 或 5 个节点。"
    },
    {
      "id": "svc-zkfc",
      "name": "HDFS ZKFailoverController（ZKFC）",
      "kind": "service",
      "description": "与 NameNode 同机部署，负责健康监控与基于 ZooKeeper 的 Active 选举。"
    },
    {
      "id": "svc-hadoop-client",
      "name": "Hadoop 客户端（CLI / REST / FUSE）",
      "kind": "api",
      "description": "通过 HDFS 客户端与 YARN 客户端访问集群，含 hdfs dfs、distcp 等命令。"
    },
    {
      "id": "svc-hiveserver2",
      "name": "HiveServer2",
      "kind": "api",
      "description": "对外提供 JDBC/ODBC/Thrift 查询入口。"
    },
    {
      "id": "svc-hive-metastore",
      "name": "Hive Metastore",
      "kind": "service",
      "description": "Hive 表结构等元数据服务，元数据持久化在外部关系型数据库。"
    },
    {
      "id": "svc-hbase-master",
      "name": "HBase Master",
      "kind": "database",
      "description": "HBase 集群管理与 Region 分配，可主备 HA。"
    },
    {
      "id": "svc-hbase-regionserver",
      "name": "HBase RegionServer",
      "kind": "database",
      "description": "HBase Region 读写服务，数据以 HFile 形式存放于 HDFS。"
    }
  ],
  "instances": [
